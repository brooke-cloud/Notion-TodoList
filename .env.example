# 将此文件复制为 .env，并填写你自己的 Notion 集成配置。
# NOTION_DATABASE_ID 可以填写数据库 ID，也可以粘贴完整的 Notion 数据库链接。
# 不要把真实密钥提交到版本控制，也不要通过聊天发送。
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DATABASE_ID=https://www.notion.so/your-workspace/your-database-id
GOAL_DATABASE_ID=your-big-goal-database-id
GOAL_DATA_SOURCE_ID=your-big-goal-data-source-id
